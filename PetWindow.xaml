<UserControl x:Class="PigPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="256" Height="256">
    <Canvas x:Name="Root">
        <!-- 小猪本体：底部居中 -->
        <Grid x:Name="Pig" Cursor="Hand" Background="Transparent" RenderTransformOrigin="0.5,1">
            <!-- 体重（变胖）和被背上的猪压扁 -->
            <!-- 满屏走时贴在墙上 / 天花板上：以脚底为圆心旋转 -->
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" />
                    <RotateTransform x:Name="SurfaceRotate" />
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- 身后且不镜像的图层（比如带代码文字的电脑） -->
            <Viewbox IsHitTestVisible="False">
                <Canvas x:Name="Behind" Width="512" Height="512" ClipToBounds="False" />
            </Viewbox>
            <Grid x:Name="Flip" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="FlipScale" ScaleX="1" />
                </Grid.RenderTransform>
                <Grid x:Name="Anim" RenderTransformOrigin="0.5,0.85">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AScale" />
                            <RotateTransform x:Name="ARotate" />
                            <TranslateTransform x:Name="AMove" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <!-- 形态背景层（在身体后面，比如苯环） -->
                    <Viewbox IsHitTestVisible="False">
                        <Canvas x:Name="Back" Width="512" Height="512" ClipToBounds="False" />
                    </Viewbox>
                    <!-- 官方动画的预渲染帧 -->
                    <Image x:Name="Lazy" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- 帧渲染完成前的占位图 -->
                    <Image x:Name="Still" Source="assets/pig_1f416.png"
                           IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- 形态叠加层：坐标统一按 512×512 的 rest 帧，随身体一起旋转/翻转 -->
                    <Viewbox IsHitTestVisible="False">
                        <Canvas x:Name="Props" Width="512" Height="512" ClipToBounds="False" />
                    </Viewbox>
                </Grid>
            </Grid>
            <!-- 不随朝向镜像的前景层（带文字的道具，避免文字被翻转） -->
            <Viewbox IsHitTestVisible="False">
                <Canvas x:Name="Front" Width="512" Height="512" ClipToBounds="False" />
            </Viewbox>
        </Grid>

        <!-- 叠罗汉的群友们（压在本体上面） -->
        <Canvas x:Name="Stack" IsHitTestVisible="False" />

        <!-- 血条（默认隐藏，受伤时短暂显示） -->
        <Border x:Name="HpBar" Height="8" Background="#66000000" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
            <Rectangle x:Name="HpFill" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Margin="1" Fill="#4CAF50" />
        </Border>

        <!-- 气泡 -->
        <Border x:Name="Bubble" Background="White" BorderBrush="#F3A3B5" BorderThickness="2"
                CornerRadius="10" Padding="8,3" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="BubbleText" Foreground="#5A3A3A" FontSize="13" FontFamily="Microsoft YaHei" />
        </Border>

        <!-- 粒子层：爱心 / Zzz -->
        <Canvas x:Name="Fx" IsHitTestVisible="False" />
    </Canvas>
</UserControl>
